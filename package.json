{
  "name": "al-quran-database",
  "version": "2.2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sync:version": "node scripts/sync-version.mjs",
    "predev": "node scripts/sync-version.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-version.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "pretypecheck": "node scripts/sync-version.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "data:convert": "python3 scripts/convert_quran_sql.py",
    "data:verify": "python3 scripts/verify_quran_data.py",
    "data:export": "python3 scripts/export_sql.py",
    "data:migrate": "python3 scripts/migrate_db.py",
    "data:seed": "python3 scripts/seed_data.py",
    "data:bench": "python3 scripts/performance_metrics.py",
    "pretest": "node scripts/sync-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "next lint --fix",
    "pretest:e2e": "node scripts/sync-version.mjs",
    "test:e2e": "playwright test",
    "prebuild:sdk": "node scripts/sync-version.mjs",
    "build:sdk": "npm run build --workspace @faha1999/al-quran-database",
    "prepack:sdk": "node scripts/sync-version.mjs",
    "pack:sdk": "npm pack --dry-run --workspace @faha1999/al-quran-database",
    "verify:sdk": "npm run build:sdk && npm run pack:sdk"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "2.1.1",
    "flexsearch": "0.8.212",
    "framer-motion": "^13.1.0",
    "graphql": "^17.0.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^6.2.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/ui": "^4.1.10",
    "eslint": "^8.57.0",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.3+sha512.a19744364a7e248b92657a4ca5973f9354d21caf982579674b1c539f32c7420c47138ad8b1254df07aba9bc782d9b3029e3db34d5dbff974326eb74dac8ff489"
}
