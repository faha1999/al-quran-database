{
  "name": "@faha1999/al-quran-database",
  "version": "2.2.0",
  "description": "Complete Quran dataset with TypeScript SDK — works offline with no server. Includes REST & GraphQL SDK, 134 translations, word-by-word data, scholarly knowledge base, and SQL exports.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/data",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faha1999/al-quran-database.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://al-quran-database.vercel.app/docs/sdk",
  "bugs": {
    "url": "https://github.com/faha1999/al-quran-database/issues"
  },
  "keywords": [
    "quran",
    "quran-data",
    "quran-dataset",
    "quran-api",
    "quran-sdk",
    "quran-database",
    "quran-json",
    "quran-search",
    "quran-typescript",
    "quran-graphql",
    "quran-offline",
    "al-quran-database",
    "islamic-data",
    "islamic-dataset",
    "islam",
    "api",
    "sdk",
    "typescript",
    "graphql",
    "rest-api",
    "offline",
    "zero-dependency",
    "standalone",
    "developer-tools",
    "nextjs",
    "sqlite",
    "postgresql",
    "word-by-word",
    "tafsir",
    "translation"
  ],
  "author": "Kawsar Ahmed Fahad",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build"
  }
}
